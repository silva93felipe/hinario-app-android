<resources>
    <style name="Theme.App" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Fundo geral -->
        <item name="android:windowBackground">@color/black</item>

        <!-- Textos -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white_soft</item>

        <!-- Cores principais -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorAccent">@color/white</item>

        <!-- Status / Nav bar -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Componentes -->
        <item name="materialCardViewStyle">@style/Card.App</item>
        <item name="textInputStyle">@style/TextInput.App</item>
    </style>

    <style name="Button.App" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Card.App" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/black_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="strokeColor">@color/white_soft</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="TextInput.App" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/black_soft</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="android:textColorHint">@color/white_soft</item>
        <item name="hintTextColor">@color/white_soft</item>
        <item name="boxStrokeColor">@color/white_soft</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="BottomNav.App" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/black_soft</item>
        <item name="itemIconTint">@color/bottom_nav_colors</item>
        <item name="itemTextColor">@color/bottom_nav_colors</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNavIndicator.App</item>
    </style>

    <style name="BottomNavIndicator.App" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/gray</item>
    </style>
</resources>
